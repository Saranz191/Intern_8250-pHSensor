        </mxCell>
        <mxCell id="fc-start" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DFF3E4;strokeColor=#2F855A;fontStyle=1;fontSize=13;" value="START" vertex="1">
