          <mxGeometry height="75" width="250" x="200" y="275" as="geometry" />
        </mxCell>
        <mxCell id="fc-default" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97706;fontSize=12;" value="&lt;b&gt;Load TCFG defaults&lt;/b&gt;&lt;br&gt;SIC8250_LoadTcfgDefaults()&lt;br&gt;WriteTcfgRegister(index, value)&lt;br&gt;SFR FE=index, FF=value" vertex="1">
          <mxGeometry height="95" width="270" x="190" y="380" as="geometry" />
        </mxCell>
        <mxCell id="fc-config" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#2F855A;fontSize=12;" value="&lt;b&gt;Configure OCP pH profile&lt;/b&gt;&lt;br&gt;SIC8250_ConfigOcpPh(channel_code=3)&lt;br&gt;Use Python register sequence&lt;br&gt;C4 = 0x18 | (3 &amp;lt;&amp;lt; 5) = 0x78" vertex="1">
          <mxGeometry height="100" width="290" x="180" y="505" as="geometry" />
        </mxCell>
        <mxCell id="fc-run" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF7EE;strokeColor=#2F855A;fontSize=12;" value="&lt;b&gt;Start potentiostat acquisition&lt;/b&gt;&lt;br&gt;PotenOneShot(): SFR C4 = 0x78&lt;br&gt;RunPoten(): SFR BF.7 = 1 (BF = 0x80)&lt;br&gt;Start timeout timer" vertex="1">
          <mxGeometry height="95" width="300" x="175" y="635" as="geometry" />
        </mxCell>
        <mxCell id="fc-ready" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8CC;strokeColor=#B7791F;fontSize=11;" value="&lt;b&gt;ADC conversion ready?&lt;/b&gt;&lt;br&gt;ReadCRDY(): read SFR B5&lt;br&gt;B5[7:4] != previous B5[7:4]" vertex="1">
          <mxGeometry height="130" width="240" x="205" y="770" as="geometry" />
        </mxCell>
        <mxCell id="fc-timeout" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8CC;strokeColor=#B7791F;fontSize=11;" value="Elapsed &amp;gt; 50 ms?" vertex="1">
          <mxGeometry height="100" width="170" x="505" y="785" as="geometry" />
        </mxCell>
        <mxCell id="fc-error" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C53030;fontSize=11;fontColor=#9B2C2C;" value="&lt;b&gt;ADC TIMEOUT / SPI ERROR&lt;/b&gt;&lt;br&gt;Log error; stop RUNPOTEN&lt;br&gt;Retry or reset according to policy" vertex="1">
          <mxGeometry height="90" width="260" x="755" y="790" as="geometry" />
        </mxCell>
        <mxCell id="fc-read" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3468C0;fontSize=12;" value="&lt;b&gt;Read ADC result&lt;/b&gt;&lt;br&gt;SFR E1 = ADCOutF (read/log only)&lt;br&gt;SFR E2 = ADCOutL; E3 = ADCOutH&lt;br&gt;ADC_code = (E3 &amp;lt;&amp;lt; 8) | E2" vertex="1">
          <mxGeometry height="100" width="310" x="170" y="940" as="geometry" />
        </mxCell>
        <mxCell id="fc-voltage" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#7C3AED;fontSize=12;" value="&lt;b&gt;Convert ADC code to VpH&lt;/b&gt;&lt;br&gt;unsigned n = 16; VREF = 2.048 V&lt;br&gt;VpH = ADC_code x VREF / 2^n" vertex="1">
          <mxGeometry height="85" width="290" x="180" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="fc-ph" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1EAFE;strokeColor=#7C3AED;fontSize=12;" value="&lt;b&gt;Convert voltage to pH&lt;/b&gt;&lt;br&gt;pH = PH_ZERO - (VpH / PH_SLOPE)&lt;br&gt;PH_ZERO = 7.0; PH_SLOPE = 0.05916 V/pH&lt;br&gt;Both constants configurable; no temperature compensation" vertex="1">
          <mxGeometry height="105" width="350" x="150" y="1185" as="geometry" />
        </mxCell>
        <mxCell id="fc-report" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3468C0;fontSize=12;" value="&lt;b&gt;Publish/store sample&lt;/b&gt;&lt;br&gt;ADC_code, VpH, pH, timestamp, status&lt;br&gt;ph_report_sample()" vertex="1">
          <mxGeometry height="80" width="270" x="190" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="fc-more" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8CC;strokeColor=#B7791F;fontSize=11;" value="Continue sampling?" vertex="1">
          <mxGeometry height="100" width="190" x="230" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="fc-wait" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=11;" value="Wait sample period&lt;br&gt;default 500 ms (configurable)" vertex="1">
          <mxGeometry height="70" width="210" x="520" y="1445" as="geometry" />
        </mxCell>
        <mxCell id="fc-end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontStyle=1;fontSize=12;" value="STOP / SAFE STATE" vertex="1">
          <mxGeometry height="50" width="160" x="245" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="fc-note-default" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#D97706;align=left;verticalAlign=top;spacing=10;fontSize=10;" value="&lt;b&gt;TCFG defaults from Python write_default()&lt;/b&gt;&lt;br&gt;01:00  02:56  03:F6  04:49  05:82&lt;br&gt;06:1B  07:00  08:00  09:00  0A:02&lt;br&gt;0B:00  0C:20  0D:10  0E:10  0F:20&lt;br&gt;10:00  11:AA  12:0A  13:10  14:10  15:06" vertex="1">
          <mxGeometry height="130" width="470" x="1250" y="140" as="geometry" />
        </mxCell>
        <mxCell id="fc-note-profile" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0FAF3;strokeColor=#2F855A;align=left;verticalAlign=top;spacing=10;fontSize=10;" value="&lt;b&gt;Python OCP/pH register profile&lt;/b&gt;&lt;br&gt;&lt;b&gt;SFR:&lt;/b&gt; B9=CC, BA=01, BB=20, BC=10, BD=04, BE=00&lt;br&gt;D5=0C, D4=33, FD=09, C1=00, C2=00, C3=00, C4=78, BF=80&lt;br&gt;&lt;b&gt;TCFG overrides:&lt;/b&gt; 08=C0, 0B=8A, 11=AA, 12=0A,&lt;br&gt;02=56, 03=00, 0D=07" vertex="1">
          <mxGeometry height="145" width="470" x="1250" y="305" as="geometry" />
        </mxCell>
        <mxCell id="fc-note-policy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;align=left;verticalAlign=top;spacing=10;fontSize=10;" value="&lt;b&gt;Implementation policy&lt;/b&gt;&lt;br&gt;- ADC ready follows develop: B5[7:4] change&lt;br&gt;- Timeout = 50 ms&lt;br&gt;- ADC code is unsigned 16-bit; E1 fraction is not used in formula&lt;br&gt;- VREF, PH_ZERO and PH_SLOPE shall be configurable constants&lt;br&gt;- No temperature compensation" vertex="1">
          <mxGeometry height="135" width="470" x="1250" y="485" as="geometry" />
        </mxCell>
        <mxCell id="fc-note-read" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8CC;strokeColor=#B7791F;align=left;verticalAlign=top;spacing=10;fontSize=10;" value="&lt;b&gt;Important function rule&lt;/b&gt;&lt;br&gt;Option A: call ReadConversionResult() once; it performs WAIT_READY + READ internally.&lt;br&gt;&lt;br&gt;Option B: FSM polls ReadCRDY(); after READY, read E1/E2/E3 directly with SFR_Read().&lt;br&gt;&lt;br&gt;Do not poll ReadCRDY() to READY and then call ReadConversionResult(), because it waits for CRDY again." vertex="1">
          <mxGeometry height="175" width="470" x="630" y="930" as="geometry" />
        </mxCell>
