        <mxCell id="fc-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1F2937;" value="SIC8250 pH Measurement - OCP Firmware Flow" vertex="1">
